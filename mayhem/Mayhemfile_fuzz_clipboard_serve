project: savantenvs/RGFW
target: fuzz_clipboard_serve

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/fuzz_clipboard_serve/testsuite

# AFL, one process per input: see mayhem/build.sh (an odd-length ATOM_PAIR list in a MULTIPLE request crashes RGFW within libFuzzer's
# in-process start-up probe). Same harness code as /mayhem/fuzz_clipboard_serve.
cmds:
  - cmd: /mayhem/fuzz_clipboard_serve-afl @@
    afl: true
    timeout: 10
